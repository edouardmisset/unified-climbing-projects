# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_ENV=development

# Clerk

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXX

# Playwright e2e (`pnpm run test:e2e`) signs in as a dedicated Clerk test-mode
# user via `@clerk/testing`. Create this user in the Clerk test instance above;
# do not use a real account.
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com

# Convex

# Deployment used by `pnpm exec convex dev`
CONVEX_DEPLOYMENT="dev:some-random-id # team: my-name-xxxx, project: name-of-the-project"

NEXT_PUBLIC_CONVEX_URL="https://small-monitor-700.convex.cloud"

# Set in each Convex deployment, not in the Next.js/Vercel environment:
# CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-instance.clerk.accounts.dev"
# MIGRATION_MAINTENANCE="false"
