# dependencies
/node_modules
/.pnpm-store/
/.pnp
.pnp.js

# Git
.worktrees

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# Caches
.stylelintcache
.eslintcache

# Dependencies
node_modules/

# Test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Visual regression test diffs (actual results and diffs are not committed; only __screenshots__ snapshots are)
**/__screenshots__-actual/
**/__screenshots__-diff/

# Convex
/convex/_generated/
/.migration-private/

# Data exports and provider snapshots must never enter Git
/src/backup/
/exports/
*.zip

# Fallow
.fallow/

.omo/