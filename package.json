{
  "name": "climbing-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run build:next",
    "format": "vp fmt ./src",
    "lint": "vp lint --fix ./src",
    "check": "vp check --fix && vp run style:lint",
    "commitlint": "commitlint --edit",
    "dev": "next dev",
    "convex:dev": "vp exec convex dev",
    "convex:dashboard": "open -a \"Brave Browser\" \"https://dashboard.convex.dev/t/edouard-6ac94/unified-climbing-app/small-monitor-700\"",
    "preview": "vp run build && next start",
    "reset": "rm -f pnpm-lock.yaml && vp install --force",
    "spell": "cspell lint --no-progress --show-suggestions --show-context --locale 'en,fr' ./src/**/*.ts*",
    "start": "next start",
    "style:lint": "stylelint --fix 'src/**/*.css'",
    "check:ci": "vp check && stylelint 'src/**/*.css'",
    "test": "vp test --project=unit --reporter=dot",
    "test:integration": "pnpm exec vp test --project=integration-convex --reporter=dot --silent=passed-only && pnpm exec vp test --project=integration-dom --reporter=dot --silent=passed-only && pnpm exec vp test --project=integration-browser --reporter=dot --silent=passed-only && pnpm exec vp test --project=integration-visual --reporter=dot --silent=passed-only && pnpm exec vp test --project=integration-visual-mobile --passWithNoTests --reporter=dot --silent=passed-only",
    "test:e2e:ci": "playwright test",
    "test:all": "vp run test --silent=passed-only && vp run test:integration && vp run test:e2e",
    "fallow": "vp test --project=unit --project=integration-convex --project=integration-dom --project=integration-browser --coverage --reporter=dot --silent=passed-only && fallow",
    "validate": "vp run check && vp run test:all && vp run build",
    "verify:github-actions": "node --experimental-strip-types scripts/verify-github-actions-pinned.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^6.39.2",
    "@clerk/themes": "^2.4.55",
    "@edouardmisset/array": "npm:@jsr/edouardmisset__array@^5.0.0",
    "@edouardmisset/date": "npm:@jsr/edouardmisset__date@^5.0.0",
    "@edouardmisset/math": "npm:@jsr/edouardmisset__math@^5.0.0",
    "@edouardmisset/object": "npm:@jsr/edouardmisset__object@^5.0.0",
    "@edouardmisset/text": "npm:@jsr/edouardmisset__text@^5.0.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/charts": "0.12.0",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.122",
    "fallow": "^3.19.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-toastify": "^11.1.0",
    "temporal-polyfill": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.30",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@edge-runtime/vm": "5.0.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@next/env": "^16.3.3",
    "@playwright/test": "1.62.1",
    "@shopify/eslint-plugin": "^50.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "convex-test": "^0.0.55",
    "cspell": "^10.1.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "happy-dom": "^20.11.12",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.2.0"
  },
  "browserslist": [
    "baseline newly available"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.24.0",
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  }
}
